# Base URL for the FinSquare API. Do not include a trailing slash.
VITE_API_URL=http://localhost:3000

# Every MFI endpoint lives under this prefix; the client joins it to VITE_API_URL.
VITE_API_PREFIX=/api/v1/mfi

# development | staging | production
VITE_APP_ENV=development

# Use local repositories and deterministic demo data.
# Set to false to wire the live login and overview dashboard to the MFI backend.
VITE_ENABLE_MOCKS=true
